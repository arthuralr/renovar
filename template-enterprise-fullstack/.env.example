# ==============================================================================
# AMBIENTE & CONFIGURAÇÕES GERAIS DO PROJETO CORPORATIVO
# ==============================================================================

# Porta de escuta do servidor Express
PORT=3000
NODE_ENV=production

# URL de conexão do PostgreSQL (Neon Cloud ou PostgreSQL padrão)
# Exemplo Neon: postgresql://USER:PASSWORD@ep-proj-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host-neon.aws.neon.tech/neondb?sslmode=require"

# Chave de API do Google Gemini (Google AI Studio)
GEMINI_API_KEY="AIzaSy_SUA_CHAVE_GEMINI_AQUI"

# Origens adicionais autorizadas para CORS (separadas por vírgula)
# Deixe em branco para utilizar a política permissiva pré-configurada (Vercel, localhost, etc.)
CORS_ORIGIN="https://meu-app.vercel.app,http://localhost:5173"

# ==============================================================================
# VARIÁVEIS PÚBLICAS DO FRONT-END (VITE)
# Injetadas durante a compilação do front-end (Vercel / Cloudflare Pages / S3)
# ==============================================================================

# URL base da API Node.js rodando na VPS (ex: https://api.meudominio.com.br)
# Se o front-end e o back-end rodarem na mesma origem, deixe em branco.
VITE_API_URL="https://api.meudominio.com.br"
