# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or local .env file.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Apps Script Web App URL ending in /exec.
# Define both in Vercel: VITE_* is embedded in the frontend at build time;
# GOOGLE_* is read by the Express API relay at runtime.
# VITE_GOOGLE_SHEETS_API_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
# GOOGLE_SHEETS_API_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
