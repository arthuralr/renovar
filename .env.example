# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or local .env file.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Backend PostgreSQL connection. Keep this value server-side; do not use a VITE_ prefix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Base URL of the Express API. VITE_* values are embedded in the frontend at build time.
# Leave empty when the frontend and API share an origin.
VITE_API_URL="https://api.example.com"

# Comma-separated frontend origins allowed to call the API from a browser.
# For local Vite development with a separately hosted API, use http://localhost:5173.
CORS_ORIGIN="https://app.example.com"
